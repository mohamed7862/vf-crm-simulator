; border-bottom:2px solid transparent; } .task-btn .ico{ width:7px; height:7px; display:inline-block; border-radius:50%; } .task-btn.active{ background:rgba(255,255,255,.12); color:#fff; font-weight:bold; border-bottom:2px solid #6FA8DC; } .task-btn:hover:not(.active){ background:rgba(255,255,255,.06); color:#fff; }  #global-search{   margin-left:auto; display:flex; align-items:center; gap:6px; background:rgba(255,255,255,.08); padding:4px 8px; border-radius:2px; } #global-search .hint-text { color: #FFD700; font-size: 10px; font-family: monospace; } #global-search .hint-text span { cursor: pointer; text-decoration: underline; margin-left: 3px; } #global-search .hint-text span:hover { color: #fff; } #global-search input{ width:110px; font-family:Tahoma; font-size:11px; padding:3px 6px; border:1px solid #162F48; border-radius:1px; background:#fff; } #global-search button{ font-family:Tahoma; font-size:11px; padding:3px 10px; cursor:pointer; background:var(--siebel-blue); color:#fff; border:1px solid #1B4F8C; border-radius:1px; } #clock{ color:#CBD8E8; font-size:11px; padding:0 8px; border-left:1px solid rgba(255,255,255,.2); margin-left:6px; }  /* Workspace */ #workspace{ padding:10px; max-width:1300px; margin:0 auto; } .window{ display:none; margin-bottom:14px; } .window.visible{ display:block; }  .titlebar{   background:var(--siebel-header); color:#fff; font-weight:600; padding:6px 10px;   display:flex; justify-content:space-between; align-items:center; font-size:11.5px; } .window-body{ padding:0; background:#fff; }  .menubar{   background:var(--face-mid); border-bottom:1px solid var(--border-mid); padding:3px 10px; display:flex; gap:16px; font-size:11px; color:#2A3A4A; } .menubar span:hover{ color:var(--link); text-decoration:underline; cursor:pointer; }  .screentabs{   display:flex; background:var(--face-mid); border-bottom:1px solid var(--border-mid); padding:0 8px; gap:2px; overflow-x:auto; } .screentab{   padding:5px 14px; font-size:11px; color:#3A4A5A; cursor:pointer; border-bottom:2px solid transparent; white-space:nowrap; } .screentab.active{   background:#fff; color:var(--siebel-header); font-weight:bold; border-bottom:2px solid var(--siebel-header); }  .viewbar{   background:#fff; border-bottom:1px solid var(--border-soft); padding:4px 10px; font-size:10.5px; color:#5A6B7A; display:flex; align-items:center; gap:6px; } .viewbar b{ color:var(--siebel-header); }  .icontoolbar{   background:#EBF0F5; border-bottom:1px solid var(--border-soft); padding:3px 8px; display:flex; gap:4px; align-items:center; } .icontoolbar .ibtn{   padding:2px 8px; font-size:10.5px; background:#fff; color:#2A3A4A; border:1px solid var(--border-soft); cursor:pointer; border-radius:1px; } .icontoolbar .ibtn:hover{ background:var(--face-mid); border-color:var(--siebel-blue); }  /* Top Form Card matching Siebel Image */ .siebel-form-top {   background: #F4F7FA; padding: 8px 12px; border-bottom: 1px solid var(--border-mid); display: flex; flex-direction: column; gap: 5px; } .form-grid-row {   display: flex; gap: 12px; align-items: center; font-size: 11px; } .form-field-unit { display: flex; align-items: center; gap: 4px; } .form-field-unit label { font-weight: bold; color: #334455; white-space: nowrap; font-size: 10.5px; } .form-field-unit input[type="text"] {   padding: 2px 4px; border: 1px solid var(--border-soft); background: #fff; font-size: 11px; font-family: Tahoma, monospace; height: 20px; } .form-checkboxes-bar {   display: flex; gap: 14px; flex-wrap: wrap; margin-top: 4px; font-size: 10.5px; align-items: center; } .form-checkboxes-bar label { display: flex; align-items: center; gap: 3px; cursor: default; } .text-danger-bold { color: #C00000; font-weight: bold; } .text-power { color: #004488; font-weight: bold; } .text-power-max { color: #007700; font-weight: bold; } .text-digital-egypt { color: #0055AA; font-weight: bold; }  /* Sub View Tabs */ .sub-tabs-bar {   background: #E2E7ED; display: flex; gap: 2px; padding: 4px 8px 0; border-botto